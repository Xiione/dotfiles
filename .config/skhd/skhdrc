# Arrow-key aliases for OmniWM's native HJKL bindings.
.shell "/bin/sh"

# Focus windows.
alt - left  : "$HOME/.local/bin/omniwmctl" command focus left
alt - down  : "$HOME/.local/bin/omniwmctl" command focus down
alt - up    : "$HOME/.local/bin/omniwmctl" command focus up
alt - right : "$HOME/.local/bin/omniwmctl" command focus right

# Move windows.
ctrl + alt - left  : "$HOME/.local/bin/omniwmctl" command move left
ctrl + alt - down  : "$HOME/.local/bin/omniwmctl" command move down
ctrl + alt - up    : "$HOME/.local/bin/omniwmctl" command move up
ctrl + alt - right : "$HOME/.local/bin/omniwmctl" command move right

# Move columns horizontally and consume or expel windows vertically.
ctrl + alt + shift - left  : "$HOME/.local/bin/omniwmctl" command move-column left
ctrl + alt + shift - down  : "$HOME/.local/bin/omniwmctl" command consume-window-into-column
ctrl + alt + shift - up    : "$HOME/.local/bin/omniwmctl" command expel-window-from-column
ctrl + alt + shift - right : "$HOME/.local/bin/omniwmctl" command move-column right

# Send windows directly to adjacent monitors.
ctrl + shift - left  : "$HOME/.local/bin/omniwmctl" command move-to-monitor left
ctrl + shift - down  : "$HOME/.local/bin/omniwmctl" command move-to-monitor down
ctrl + shift - up    : "$HOME/.local/bin/omniwmctl" command move-to-monitor up
ctrl + shift - right : "$HOME/.local/bin/omniwmctl" command move-to-monitor right
