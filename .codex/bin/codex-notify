#!/usr/bin/env python3
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

HOST_QUERY = """
(function()
    local terminal = require("sidekick.cli.session").attached()[_A.session]
    return vim.json.encode({
        pid = vim.uv.os_getpid(),
        neogurt = vim.g.neogurt == true,
        cwd = terminal and terminal.cwd,
        running = terminal and terminal:is_running() or false,
        can_focus = vim.fn.exists(":CodexNotifyFocus") == 2,
    })
end)()
""".replace("\n", " ")

NOTIFICATION_GLYPHS = {
    "": "🔎",
    "": "✏️",
    "": "⌨️",
    "": "🧪",
    "": "🐛",
    "": "✅",
    "": "⚠️",
    "": "⛔",
    "": "ℹ️",
    "": "💡",
    "": "🔐",
    "": "🔒",
    "": "📄",
    "": "📁",
    "": "🧩",
    "": "➕",
    "": "➖",
    "": "📝",
    "": "🔀",
    "": "👀",
}


def notification_text(text):
    return "".join(NOTIFICATION_GLYPHS.get(char, char) for char in text)


def resolve_path(path):
    return os.path.realpath(os.path.expanduser(path))


def remote_eval(nvim, server, expression, argument):
    def quote_vim(text):
        return "'" + text.replace("'", "''") + "'"

    expression = (
        f"luaeval({quote_vim(expression)}, "
        f"json_decode({quote_vim(json.dumps(argument))}))"
    )
    result = subprocess.run(
        [nvim, "--server", server, "--remote-expr", expression],
        capture_output=True,
        text=True,
        timeout=3,
        check=False,
    )
    if result.returncode:
        raise RuntimeError(
            one_line(result.stderr or result.stdout or "Neovim RPC failed", 240)
        )
    return result.stdout.strip()


def find_hosts(target):
    hosts = []
    for path in Path(target["registry"]).glob("codex *.json"):
        try:
            host = json.loads(path.read_text())
            if (
                not isinstance(host, dict)
                or host.get("version") != 1
                or not isinstance(host.get("cwd"), str)
                or resolve_path(host["cwd"]) != target["cwd"]
                or not isinstance(host.get("server"), str)
                or not host["server"]
                or type(host.get("pid")) is not int
                or host["pid"] <= 0
                or not isinstance(host.get("session"), str)
                or not re.fullmatch(r"codex [0-9a-f]+", host["session"])
            ):
                continue
            snapshot = json.loads(
                remote_eval(
                    target["nvim"],
                    host["server"],
                    HOST_QUERY,
                    {"session": "terminal: " + host["session"]},
                )
            )
            if (
                isinstance(snapshot, dict)
                and snapshot.get("pid") == host["pid"]
                and snapshot.get("neogurt") is True
                and snapshot.get("running") is True
                and isinstance(snapshot.get("cwd"), str)
                and resolve_path(snapshot["cwd"]) == target["cwd"]
            ):
                hosts.append({**host, "can_focus": snapshot.get("can_focus") is True})
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
            continue
    return hosts


def focus_neogurt(payload):
    cwd = os.getcwd()
    try:
        subprocess.run(
            ["/usr/bin/open", "/Applications/neogurt.app"],
            capture_output=True,
            text=True,
            check=True,
            timeout=5,
        )
        target = json.loads(payload)
        if not isinstance(target, dict) or any(
            not isinstance(target.get(key), str) or not target[key]
            for key in ("cwd", "registry", "nvim")
        ):
            raise ValueError(
                "Invalid Neogurt click payload; cwd, registry, and nvim are required"
            )
        cwd = target["cwd"] = resolve_path(target["cwd"])
        hosts = find_hosts(target)
        origin_hosts = [
            host for host in hosts if host["server"] == target.get("server")
        ]
        hosts = origin_hosts or hosts
        if not hosts:
            raise RuntimeError(
                "The matching Neogurt Codex session is no longer available"
            )
        if len(hosts) != 1:
            raise RuntimeError("Multiple Neogurt Codex sessions match this directory")
        host = hosts[0]
        if not host["can_focus"]:
            raise RuntimeError(
                "Reload the Sidekick configuration in the matching Neogurt session"
            )
        remote_eval(
            target["nvim"],
            host["server"],
            'vim.api.nvim_cmd({cmd = "CodexNotifyFocus", args = {vim.json.encode(_A)}}, {})',
            {"cwd": cwd, "session": "terminal: " + host["session"], "pid": host["pid"]},
        )
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        message = one_line(str(error), 240)
        print(f"codex-notify: {cwd}: {message}", file=sys.stderr)
        if not notify_with_terminal_notifier(
            "Codex focus failed", cwd, message, cwd, click_args=[]
        ):
            notify_with_osascript("Codex focus failed", cwd, message)
        return 1


def git_output(path, args):
    try:
        result = subprocess.run(
            ["git", "-C", path, *args],
            capture_output=True,
            check=False,
            text=True,
            timeout=1.5,
        )
    except Exception:
        return None

    output = result.stdout.strip()
    if result.returncode != 0 or output == "":
        return None
    return output


def last_path_parts(path, count=2):
    parts = [part for part in path.split("/") if part]
    return "/".join(parts[-count:]) if parts else path


def parent_dir_label(path):
    p = Path(path)
    name = p.name or str(p)
    parent = p.parent.name
    return f"{parent}/{name}" if parent else name


def session_name(path):
    path = os.path.abspath(os.path.expanduser(path or os.getcwd()))
    root = git_output(path, ["rev-parse", "--show-toplevel"])
    if not root:
        return parent_dir_label(path)

    repo = Path(root).name
    branch = git_output(path, ["branch", "--show-current"])
    if not branch:
        commit = git_output(path, ["rev-parse", "--short", "HEAD"])
        branch = f"@{commit}" if commit else "HEAD"

    prefix = git_output(path, ["rev-parse", "--show-prefix"]) or ""
    directory = prefix.rstrip("/")
    label = "." if directory == "" else last_path_parts(directory, 2)

    return f"{repo}:{branch} {label}"


def one_line(text, limit=180):
    text = " ".join((text or "").split())
    if len(text) <= limit:
        return text
    return text[: limit - 1].rstrip() + "..."


def text_from_value(value):
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        parts = []
        for item in value:
            text = text_from_value(item)
            if text:
                parts.append(text)
        return "\n".join(parts)
    if isinstance(value, dict):
        for key in ("text", "content", "message", "value"):
            text = text_from_value(value.get(key))
            if text:
                return text
    return None


def prompt_from_notification(notification):
    for key in (
        "prompt",
        "last-user-message",
        "last-user-input",
        "user-prompt",
        "input",
    ):
        text = text_from_value(notification.get(key))
        if text:
            return text

    for key in ("messages", "conversation", "items"):
        items = notification.get(key)
        if not isinstance(items, list):
            continue

        for item in reversed(items):
            if not isinstance(item, dict):
                continue

            role = item.get("role")
            item_type = item.get("type")
            if role != "user" and item_type not in ("user_message", "input_text"):
                continue

            text = text_from_value(item)
            if text:
                return text

    return None


def applescript_string(text):
    return (
        '"' + text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'
    )


def codex_icon():
    for path in (
        "/Applications/Codex.app/Contents/Resources/icon.png",
        "/Applications/Codex.app/Contents/Resources/icon.icns",
    ):
        if Path(path).is_file():
            return path
    return None


def click_action(cwd):
    action = os.environ.get("CODEX_NOTIFY_ACTION", "activate-neogurt")
    cwd = os.path.abspath(os.path.expanduser(cwd))
    if action == "activate-neogurt":
        state_home = os.environ.get("XDG_STATE_HOME") or str(
            Path.home() / ".local/state"
        )
        app_name = os.environ.get("NVIM_APPNAME") or "nvim"
        target = {
            "cwd": resolve_path(cwd),
            "server": os.environ.get("NVIM"),
            "registry": str(Path(state_home) / app_name / "sidekick/rendezvous"),
            "nvim": shutil.which("nvim") or "",
        }
        command = shlex.join(
            [
                sys.executable,
                os.path.abspath(__file__),
                "--focus-neogurt",
                json.dumps(target),
            ]
        )
        return ["-execute", command]
    if action == "open-cwd":
        return ["-open", Path(cwd).as_uri()]
    if action == "reveal-cwd":
        return ["-execute", f"open -R {sh_quote(cwd)}"]
    if action == "none":
        return []
    return ["-activate", "com.openai.codex"]


def sh_quote(text):
    return "'" + text.replace("'", "'\\''") + "'"


def notify_with_terminal_notifier(title, subtitle, message, cwd, click_args=None):
    terminal_notifier = shutil.which("terminal-notifier")
    if not terminal_notifier:
        return False

    args = [
        terminal_notifier,
        "-title",
        notification_text(title),
        "-subtitle",
        notification_text(subtitle),
        "-message",
        notification_text(message),
        "-group",
        f"codex:{os.path.abspath(os.path.expanduser(cwd))}",
    ]

    icon = codex_icon()
    if icon:
        args.extend(["-appIcon", icon])

    args.extend(click_action(cwd) if click_args is None else click_args)
    subprocess.run(args, check=False)
    return True


def notify_with_osascript(title, subtitle, message):
    osascript = shutil.which("osascript") or "/usr/bin/osascript"
    subprocess.run(
        [
            osascript,
            "-e",
            "display notification "
            + applescript_string(notification_text(message))
            + " with title "
            + applescript_string(notification_text(title))
            + " subtitle "
            + applescript_string(notification_text(subtitle)),
        ],
        check=False,
    )


def main():
    if len(sys.argv) < 2:
        return 0
    if sys.argv[1] == "--focus-neogurt":
        return focus_neogurt(sys.argv[2] if len(sys.argv) > 2 else "")

    try:
        notification = json.loads(sys.argv[1])
    except json.JSONDecodeError:
        return 0

    if notification.get("type") != "agent-turn-complete":
        return 0

    cwd = notification.get("cwd") or os.getcwd()
    title = "Codex"
    subtitle = session_name(cwd)
    message = one_line(
        notification_text(
            prompt_from_notification(notification)
            or notification.get("last-assistant-message")
            or "Turn complete"
        )
    )

    if os.environ.get("CODEX_NOTIFY_DRY_RUN"):
        print(json.dumps({"title": title, "subtitle": subtitle, "message": message}))
        return 0

    if not notify_with_terminal_notifier(title, subtitle, message, cwd):
        notify_with_osascript(title, subtitle, message)
    return 0


if __name__ == "__main__":
    sys.exit(main())
