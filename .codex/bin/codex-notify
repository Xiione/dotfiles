#!/usr/bin/env python3
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOST_QUERY = """
(function()
    local terminal = require("sidekick.cli.session").attached()[_A.session]
    return vim.json.encode({
        pid = vim.uv.os_getpid(),
        neogurt = vim.g.neogurt == true,
        cwd = terminal and terminal.cwd,
        running = terminal and terminal:is_running() or false,
        can_focus = vim.fn.exists(":CodexNotifyFocus") == 2,
    })
end)()
""".replace("\n", " ")

FOCUSED_TERMINAL_QUERY = """
(function()
    if vim.g.neogurt ~= true or vim.uv.os_getppid() ~= _A.app_pid
        or vim.uv.os_getpid() ~= _A.pid then
        return "{}"
    end
    local win = vim.api.nvim_get_current_win()
    local buf = vim.api.nvim_win_get_buf(win)
    local terminal = require("sidekick.cli.terminal").get("terminal: " .. _A.session)
    if not terminal or terminal.win ~= win or terminal.buf ~= buf
        or terminal.tool.name ~= "codex" or terminal.mux_backend ~= "zellij"
        or terminal.sid ~= _A.session or not terminal:is_running()
        or vim.bo[buf].buftype ~= "terminal" or vim.fn.pumvisible() ~= 0
        or vim.fn.line("w$") ~= vim.api.nvim_buf_line_count(buf) then
        return "{}"
    end
    local session = vim.g.neogurt_cmd("session_info")
    local active = vim.g.neogurt_cmd("session_list", { sort = "time" })[1]
    if not session or not active or session.id ~= active.id then
        return "{}"
    end
    return vim.json.encode({ session_id = session.id, win = win, buf = buf, job = terminal.job })
end)()
""".replace("\n", " ")

FRONTMOST_APP_SCRIPT = """
ObjC.import("AppKit");
const app = $.NSWorkspace.sharedWorkspace.frontmostApplication;
JSON.stringify([ObjC.unwrap(app.bundleIdentifier), app.processIdentifier]);
"""

THREAD_ID = re.compile(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", re.I)
SGR = re.compile(r"\x1b\[([0-9;:]*)m")
COMPOSER_CHEVRONS = re.compile(r"[›]")  # Unfiltered and filtered prompt glyphs.
COMPOSER_PROMPT = "\0"

NOTIFICATION_GLYPHS = {
    "": "🔎",
    "": "✏️",
    "": "⌨️",
    "": "🧪",
    "": "🐛",
    "": "✅",
    "": "⚠️",
    "": "⛔",
    "": "ℹ️",
    "": "💡",
    "": "🔐",
    "": "🔒",
    "": "📄",
    "": "📁",
    "": "🧩",
    "": "➕",
    "": "➖",
    "": "📝",
    "": "🔀",
    "": "👀",
}


def notification_text(text):
    return "".join(NOTIFICATION_GLYPHS.get(char, char) for char in text)


def resolve_path(path):
    return os.path.realpath(os.path.expanduser(path))


def remote_eval(nvim, server, expression, argument, timeout=3):
    def quote_vim(text):
        return "'" + text.replace("'", "''") + "'"

    expression = (
        f"luaeval({quote_vim(expression)}, "
        f"json_decode({quote_vim(json.dumps(argument))}))"
    )
    result = subprocess.run(
        [nvim, "--server", server, "--remote-expr", expression],
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )
    if result.returncode:
        raise RuntimeError(
            one_line(result.stderr or result.stdout or "Neovim RPC failed", 240)
        )
    return result.stdout.strip()


def rendezvous_records(registry):
    for path in Path(registry).glob("codex *.json"):
        try:
            host = json.loads(path.read_text())
            if (
                not isinstance(host, dict)
                or host.get("version") != 1
                or not isinstance(host.get("cwd"), str)
                or not isinstance(host.get("server"), str)
                or not host["server"]
                or type(host.get("pid")) is not int
                or host["pid"] <= 0
                or not isinstance(host.get("session"), str)
                or not re.fullmatch(r"codex [0-9a-f]+", host["session"])
            ):
                continue
            yield host
        except (OSError, ValueError):
            continue


def find_hosts(target):
    hosts = []
    for host in rendezvous_records(target["registry"]):
        try:
            if resolve_path(host["cwd"]) != target["cwd"]:
                continue
            snapshot = json.loads(
                remote_eval(
                    target["nvim"],
                    host["server"],
                    HOST_QUERY,
                    {"session": "terminal: " + host["session"]},
                )
            )
            if (
                isinstance(snapshot, dict)
                and snapshot.get("pid") == host["pid"]
                and snapshot.get("neogurt") is True
                and snapshot.get("running") is True
                and isinstance(snapshot.get("cwd"), str)
                and resolve_path(snapshot["cwd"]) == target["cwd"]
            ):
                hosts.append({**host, "can_focus": snapshot.get("can_focus") is True})
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
            continue
    return hosts


def rendezvous_dir():
    state_home = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    app_name = os.environ.get("NVIM_APPNAME") or "nvim"
    return Path(state_home) / app_name / "sidekick/rendezvous"


def composer_rows(screen):
    # Zellij emits SGR changes between text spans. Codex paints the active prompt
    # in bold and the parked companion without bold.
    rows = []
    bold = False
    for row in screen.splitlines():
        spans = SGR.split(row)
        painted = [COMPOSER_CHEVRONS.sub(COMPOSER_PROMPT, spans[0]) if bold else spans[0]]
        for style, span in zip(spans[1::2], spans[2::2]):
            if style in ("", "0", "22"):
                bold = False
            elif style == "1":
                bold = True
            painted.append(COMPOSER_CHEVRONS.sub(COMPOSER_PROMPT, span) if bold else span)
        rows.append("".join(painted))
    return rows


def focused_thread_id(screen):
    rows = composer_rows(screen)
    for index in range(len(rows) - 1, -1, -1):
        columns = rows[index].split("│")
        prompts = [
            i for i, text in enumerate(columns)
            if text.lstrip().startswith(COMPOSER_PROMPT)
        ]
        if prompts:
            if len(columns) > 2 or len(prompts) != 1:
                return None
            column = prompts[0]
            break
    else:
        return None

    footer = []
    for row in rows[index + 1:]:
        parts = row.split("│", len(columns) - 1) if len(columns) == 2 else [row]
        if len(parts) != len(columns):
            if not row.strip():
                continue
            return None
        footer.append(parts[column].strip())
    while footer and not footer[-1]:
        footer.pop()
    if "" not in footer:
        return None
    last_blank = max(index for index, row in enumerate(footer) if not row)
    footer = footer[last_blank + 1:]

    # Codex can wrap a UUID after a hyphen. Only accept a complete status-line
    # field, including when the field spans adjacent footer rows.
    status = re.sub(
        r"(?<=[0-9a-f]-)\n(?=[0-9a-f])", "", "\n".join(footer), flags=re.I
    )
    fields = re.split(r"[·\n]", status)
    ids = [field.strip().lower() for field in fields if THREAD_ID.fullmatch(field.strip())]
    return ids[0] if len(ids) == 1 else None


def should_suppress(thread_id):
    if not isinstance(thread_id, str) or not THREAD_ID.fullmatch(thread_id):
        return False
    deadline = time.monotonic() + 2

    def remaining():
        timeout = deadline - time.monotonic()
        if timeout <= 0:
            raise TimeoutError("Focus check timed out")
        return timeout

    def probe(args):
        return subprocess.run(
            args, capture_output=True, text=True, check=True, timeout=remaining()
        ).stdout

    def frontmost_app():
        return json.loads(probe(
            ["/usr/bin/osascript", "-l", "JavaScript", "-e", FRONTMOST_APP_SCRIPT]
        ))

    def focused_terminal(host):
        return json.loads(remote_eval(
            nvim, host["server"], FOCUSED_TERMINAL_QUERY,
            {"app_pid": app_pid, "pid": host["pid"], "session": host["session"]},
            timeout=remaining(),
        ))

    try:
        app = frontmost_app()
        if not isinstance(app, list) or len(app) != 2:
            return False
        bundle, app_pid = app
        if bundle != "com.github.williamhCode.neogurt" or type(app_pid) is not int or app_pid <= 0:
            return False
        nvim = shutil.which("nvim")
        zellij = shutil.which("zellij")
        if not nvim or not zellij:
            return False

        focused = []
        for host in rendezvous_records(rendezvous_dir()):
            try:
                snapshot = focused_terminal(host)
            except (RuntimeError, ValueError):
                # A stale socket or a host with an incompatible RPC cannot be a match.
                continue
            if isinstance(snapshot, dict) and all(
                type(snapshot.get(key)) is int for key in ("session_id", "win", "buf", "job")
            ):
                focused.append((host, snapshot))
        if len(focused) != 1:
            return False
        host, snapshot = focused[0]

        command = [zellij, "--session", host["session"], "action"]
        panes = json.loads(probe([*command, "list-panes", "--json"]))
        if not isinstance(panes, list) or any(not isinstance(pane, dict) for pane in panes):
            return False
        visible = [pane for pane in panes if pane.get("is_suppressed") is False]
        if len(visible) != 1:
            return False
        pane = visible[0]
        pane_id = pane.get("id")
        terminal_command = pane.get("terminal_command")
        if (
            pane.get("is_plugin") is not False
            or pane.get("is_focused") is not True
            or pane.get("exited") is not False
            or type(pane_id) is not int
            or pane_id < 0
            or not isinstance(terminal_command, str)
            or Path(terminal_command).name not in ("codex-terminal-filter", "codex")
        ):
            return False
        screen = probe(
            [*command, "dump-screen", "--pane-id", f"terminal_{pane_id}", "--ansi"]
        )
        return (
            focused_thread_id(screen) == thread_id.lower()
            and focused_terminal(host) == snapshot
            and frontmost_app() == app
        )
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        return False


def focus_neogurt(payload):
    cwd = os.getcwd()
    try:
        subprocess.run(
            ["/usr/bin/open", "/Applications/neogurt.app"],
            capture_output=True,
            text=True,
            check=True,
            timeout=5,
        )
        target = json.loads(payload)
        if not isinstance(target, dict) or any(
            not isinstance(target.get(key), str) or not target[key]
            for key in ("cwd", "registry", "nvim")
        ):
            raise ValueError(
                "Invalid Neogurt click payload; cwd, registry, and nvim are required"
            )
        cwd = target["cwd"] = resolve_path(target["cwd"])
        hosts = find_hosts(target)
        origin_hosts = [
            host for host in hosts if host["server"] == target.get("server")
        ]
        hosts = origin_hosts or hosts
        if not hosts:
            raise RuntimeError(
                "The matching Neogurt Codex session is no longer available"
            )
        if len(hosts) != 1:
            raise RuntimeError("Multiple Neogurt Codex sessions match this directory")
        host = hosts[0]
        if not host["can_focus"]:
            raise RuntimeError(
                "Reload the Sidekick configuration in the matching Neogurt session"
            )
        remote_eval(
            target["nvim"],
            host["server"],
            'vim.api.nvim_cmd({cmd = "CodexNotifyFocus", args = {vim.json.encode(_A)}}, {})',
            {"cwd": cwd, "session": "terminal: " + host["session"], "pid": host["pid"]},
        )
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        message = one_line(str(error), 240)
        print(f"codex-notify: {cwd}: {message}", file=sys.stderr)
        if not notify_with_terminal_notifier(
            "Codex focus failed", cwd, message, cwd, click_args=[]
        ):
            notify_with_osascript("Codex focus failed", cwd, message)
        return 1


def git_output(path, args):
    try:
        result = subprocess.run(
            ["git", "-C", path, *args],
            capture_output=True,
            check=False,
            text=True,
            timeout=1.5,
        )
    except Exception:
        return None

    output = result.stdout.strip()
    if result.returncode != 0 or output == "":
        return None
    return output


def last_path_parts(path, count=2):
    parts = [part for part in path.split("/") if part]
    return "/".join(parts[-count:]) if parts else path


def parent_dir_label(path):
    p = Path(path)
    name = p.name or str(p)
    parent = p.parent.name
    return f"{parent}/{name}" if parent else name


def session_name(path):
    path = os.path.abspath(os.path.expanduser(path or os.getcwd()))
    root = git_output(path, ["rev-parse", "--show-toplevel"])
    if not root:
        return parent_dir_label(path)

    repo = Path(root).name
    branch = git_output(path, ["branch", "--show-current"])
    if not branch:
        commit = git_output(path, ["rev-parse", "--short", "HEAD"])
        branch = f"@{commit}" if commit else "HEAD"

    prefix = git_output(path, ["rev-parse", "--show-prefix"]) or ""
    directory = prefix.rstrip("/")
    label = "." if directory == "" else last_path_parts(directory, 2)

    return f"{repo}:{branch} {label}"


def one_line(text, limit=180):
    text = " ".join((text or "").split())
    if len(text) <= limit:
        return text
    return text[: limit - 1].rstrip() + "..."


def text_from_value(value):
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        parts = []
        for item in value:
            text = text_from_value(item)
            if text:
                parts.append(text)
        return "\n".join(parts)
    if isinstance(value, dict):
        for key in ("text", "content", "message", "value"):
            text = text_from_value(value.get(key))
            if text:
                return text
    return None


def prompt_from_notification(notification):
    for key in (
        "prompt",
        "last-user-message",
        "last-user-input",
        "user-prompt",
        "input",
    ):
        text = text_from_value(notification.get(key))
        if text:
            return text

    for key in ("messages", "conversation", "items"):
        items = notification.get(key)
        if not isinstance(items, list):
            continue

        for item in reversed(items):
            if not isinstance(item, dict):
                continue

            role = item.get("role")
            item_type = item.get("type")
            if role != "user" and item_type not in ("user_message", "input_text"):
                continue

            text = text_from_value(item)
            if text:
                return text

    return None


def applescript_string(text):
    return (
        '"' + text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'
    )


def codex_icon():
    for path in (
        "/Applications/Codex.app/Contents/Resources/icon.png",
        "/Applications/Codex.app/Contents/Resources/icon.icns",
    ):
        if Path(path).is_file():
            return path
    return None


def click_action(cwd):
    action = os.environ.get("CODEX_NOTIFY_ACTION", "activate-neogurt")
    cwd = os.path.abspath(os.path.expanduser(cwd))
    if action == "activate-neogurt":
        target = {
            "cwd": resolve_path(cwd),
            "server": os.environ.get("NVIM"),
            "registry": str(rendezvous_dir()),
            "nvim": shutil.which("nvim") or "",
        }
        command = shlex.join(
            [
                sys.executable,
                os.path.abspath(__file__),
                "--focus-neogurt",
                json.dumps(target),
            ]
        )
        return ["-execute", command]
    if action == "open-cwd":
        return ["-open", Path(cwd).as_uri()]
    if action == "reveal-cwd":
        return ["-execute", f"open -R {sh_quote(cwd)}"]
    if action == "none":
        return []
    return ["-activate", "com.openai.codex"]


def sh_quote(text):
    return "'" + text.replace("'", "'\\''") + "'"


def notify_with_terminal_notifier(title, subtitle, message, cwd, click_args=None):
    terminal_notifier = shutil.which("terminal-notifier")
    if not terminal_notifier:
        return False

    args = [
        terminal_notifier,
        "-title",
        notification_text(title),
        "-subtitle",
        notification_text(subtitle),
        "-message",
        notification_text(message),
        "-group",
        f"codex:{os.path.abspath(os.path.expanduser(cwd))}",
    ]

    icon = codex_icon()
    if icon:
        args.extend(["-appIcon", icon])

    args.extend(click_action(cwd) if click_args is None else click_args)
    subprocess.run(args, check=False)
    return True


def notify_with_osascript(title, subtitle, message):
    osascript = shutil.which("osascript") or "/usr/bin/osascript"
    subprocess.run(
        [
            osascript,
            "-e",
            "display notification "
            + applescript_string(notification_text(message))
            + " with title "
            + applescript_string(notification_text(title))
            + " subtitle "
            + applescript_string(notification_text(subtitle)),
        ],
        check=False,
    )


def main():
    if len(sys.argv) < 2:
        return 0
    if sys.argv[1] == "--focus-neogurt":
        return focus_neogurt(sys.argv[2] if len(sys.argv) > 2 else "")

    try:
        notification = json.loads(sys.argv[1])
    except json.JSONDecodeError:
        return 0

    if not isinstance(notification, dict) or notification.get("type") != "agent-turn-complete":
        return 0

    dry_run = os.environ.get("CODEX_NOTIFY_DRY_RUN")
    if not dry_run and should_suppress(notification.get("thread-id")):
        return 0

    cwd = notification.get("cwd") or os.getcwd()
    title = "Codex"
    subtitle = session_name(cwd)
    message = one_line(
        notification_text(
            prompt_from_notification(notification)
            or notification.get("last-assistant-message")
            or "Turn complete"
        )
    )

    if dry_run:
        print(json.dumps({"title": title, "subtitle": subtitle, "message": message}))
        return 0

    if not notify_with_terminal_notifier(title, subtitle, message, cwd):
        notify_with_osascript(title, subtitle, message)
    return 0


if __name__ == "__main__":
    sys.exit(main())
